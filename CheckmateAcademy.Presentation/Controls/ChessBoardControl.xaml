<UserControl x:Class="CheckmateAcademy.Presentation.Controls.ChessBoardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320"
             MinHeight="320"
             SnapsToDevicePixels="True">

	<Border Background="{StaticResource CardBackground}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12">

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="22"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="22"/>
			</Grid.RowDefinitions>

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="22"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="22"/>
			</Grid.ColumnDefinitions>

			<UniformGrid x:Name="TopCoordinates"
                         Grid.Row="0"
                         Grid.Column="1"
                         Rows="1"/>

			<UniformGrid x:Name="LeftCoordinates"
                         Grid.Row="1"
                         Grid.Column="0"
                         Columns="1"/>

			<Grid x:Name="BoardGrid"
                  Grid.Row="1"
                  Grid.Column="1"
                  ClipToBounds="True"/>

			<UniformGrid x:Name="RightCoordinates"
                         Grid.Row="1"
                         Grid.Column="2"
                         Columns="1"/>

			<UniformGrid x:Name="BottomCoordinates"
                         Grid.Row="2"
                         Grid.Column="1"
                         Rows="1"/>
		</Grid>
	</Border>
</UserControl>
