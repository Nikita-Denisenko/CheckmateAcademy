<Window x:Class="CheckmateAcademy.Presentation.Views.Auth.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Checkmate Academy"
        Width="1440"
        Height="900"
        MinWidth="1240"
        MinHeight="930"
        WindowStartupLocation="CenterScreen"
        Background="#080F1D"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="AuthWindow_Loaded"
        SizeChanged="AuthWindow_SizeChanged">

    <Window.Resources>
        <Style x:Key="FeatureCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#111E33"/>
            <Setter Property="BorderBrush" Value="#263B5B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="19,15"/>
            <Setter Property="Margin" Value="0,0,0,17"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14"
                                      ShadowDepth="0"
                                      Color="#2563EB"
                                      Opacity="0.035"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FloatingBubbleStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#14243B"/>
            <Setter Property="BorderBrush" Value="#304B70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="100"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="13"
                                      ShadowDepth="0"
                                      Color="#3B82F6"
                                      Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot"
          ClipToBounds="False"
          PreviewMouseDown="WindowRoot_PreviewMouseDown">

        <Grid.Background>
            <RadialGradientBrush Center="0.78,0.45"
                                 GradientOrigin="0.78,0.45"
                                 RadiusX="0.8"
                                 RadiusY="0.9">
                <GradientStop Color="#142B50" Offset="0"/>
                <GradientStop Color="#0B172A" Offset="0.48"/>
                <GradientStop Color="#080F1D" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Canvas IsHitTestVisible="False">
            <Ellipse Width="430"
                     Height="430"
                     Canvas.Left="-180"
                     Canvas.Top="170"
                     Fill="#102B5A"
                     Opacity="0.17">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse Width="520"
                     Height="520"
                     Canvas.Right="-160"
                     Canvas.Top="120"
                     Fill="#1D4ED8"
                     Opacity="0.12">
                <Ellipse.Effect>
                    <BlurEffect Radius="120"/>
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <Canvas x:Name="DecorationPanel"
                IsHitTestVisible="False"
                ClipToBounds="True">

            <TextBlock Text="♛"
                       FontFamily="Segoe UI Symbol"
                       FontSize="430"
                       Foreground="#60A5FA"
                       Opacity="0.035"
                       Canvas.Right="-30"
                       Canvas.Top="100"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="-12"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock Text="♞"
                       FontFamily="Segoe UI Symbol"
                       FontSize="230"
                       Foreground="#60A5FA"
                       Opacity="0.035"
                       Canvas.Left="20"
                       Canvas.Bottom="-65"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="14"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <Ellipse Width="520"
                     Height="520"
                     Canvas.Right="-180"
                     Canvas.Top="160"
                     Stroke="#3B82F6"
                     StrokeThickness="1"
                     Opacity="0.08"/>

            <Ellipse Width="390"
                     Height="390"
                     Canvas.Right="-115"
                     Canvas.Top="225"
                     Stroke="#60A5FA"
                     StrokeThickness="1"
                     Opacity="0.06"/>

            <Rectangle Width="420"
                       Height="1"
                       Canvas.Right="30"
                       Canvas.Top="250"
                       Fill="#60A5FA"
                       Opacity="0.07"
                       RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="-35"/>
                </Rectangle.RenderTransform>
            </Rectangle>

            <Rectangle Width="420"
                       Height="1"
                       Canvas.Right="30"
                       Canvas.Top="570"
                       Fill="#60A5FA"
                       Opacity="0.06"
                       RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="35"/>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderPanel"
                    Grid.Row="0"
                    Background="#0B1424"
                    BorderBrush="#1E2D45"
                    BorderThickness="0,0,0,1"
                    Padding="42,16">

                <StackPanel Orientation="Horizontal">
                    <Border Width="58"
                            Height="58"
                            CornerRadius="16"
                            Background="#172D50"
                            BorderBrush="#31558B"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="♛"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="40"
                                   Foreground="#60A5FA"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center"
                                Margin="17,0,0,0">
                        <TextBlock Text="CHECKMATE"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"/>

                        <TextBlock Text="A C A D E M Y"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#60A5FA"
                                   Margin="2,5,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="FloatingPiecesPanel"
                            Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,5,0,0"
                            Opacity="0">

                    <StackPanel.LayoutTransform>
                        <ScaleTransform x:Name="FloatingPiecesScale"
                                        ScaleX="1"
                                        ScaleY="1"/>
                    </StackPanel.LayoutTransform>

                    <Border Style="{StaticResource FloatingBubbleStyle}"
                            Width="52"
                            Height="52"
                            Margin="0,0,24,0"
                            MouseEnter="FloatingBubble_MouseEnter"
                            MouseLeave="FloatingBubble_MouseLeave">
                        <TextBlock Text="♙"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="27"
                                   Foreground="#8CBFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Style="{StaticResource FloatingBubbleStyle}"
                            Width="58"
                            Height="58"
                            Margin="0,0,24,0"
                            MouseEnter="FloatingBubble_MouseEnter"
                            MouseLeave="FloatingBubble_MouseLeave">
                        <TextBlock Text="♘"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="31"
                                   Foreground="#8CBFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Style="{StaticResource FloatingBubbleStyle}"
                            Width="48"
                            Height="48"
                            Margin="0,0,24,0"
                            MouseEnter="FloatingBubble_MouseEnter"
                            MouseLeave="FloatingBubble_MouseLeave">
                        <TextBlock Text="♗"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="25"
                                   Foreground="#8CBFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Style="{StaticResource FloatingBubbleStyle}"
                            Width="62"
                            Height="62"
                            Margin="0,0,24,0"
                            MouseEnter="FloatingBubble_MouseEnter"
                            MouseLeave="FloatingBubble_MouseLeave">
                        <TextBlock Text="♕"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="34"
                                   Foreground="#8CBFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Style="{StaticResource FloatingBubbleStyle}"
                            Width="50"
                            Height="50"
                            Margin="0,0,24,0"
                            MouseEnter="FloatingBubble_MouseEnter"
                            MouseLeave="FloatingBubble_MouseLeave">
                        <TextBlock Text="♖"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="26"
                                   Foreground="#8CBFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Style="{StaticResource FloatingBubbleStyle}"
                            Width="56"
                            Height="56"
                            MouseEnter="FloatingBubble_MouseEnter"
                            MouseLeave="FloatingBubble_MouseLeave">
                        <TextBlock Text="♔"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="30"
                                   Foreground="#8CBFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <Grid x:Name="ContentPanel"
                      Grid.Row="1"
                      Margin="55,15,55,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="IntroPanel"
                          Grid.Column="0"
                          Margin="0,0,40,0"
                          VerticalAlignment="Center">

                        <StackPanel>

                            <Border Background="#172F52"
                                    BorderBrush="#35649D"
                                    BorderThickness="1"
                                    CornerRadius="22"
                                    Padding="19,13"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,23">

                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10"
                                             Height="10"
                                             Fill="#60A5FA"
                                             Margin="0,0,12,0"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="ТВОЯ ШАХМАТНАЯ ПЛАТФОРМА"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#DBEAFE"/>
                                </StackPanel>
                            </Border>

                            <TextBlock FontSize="50"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"
                                       TextWrapping="Wrap"
                                       TextAlignment="Left"
                                       HorizontalAlignment="Left"
                                       LineHeight="58">

                                <Run Text="Твой следующий"/>
                                <LineBreak/>
                                <Run Text="ход "
                                     Foreground="#60A5FA"/>
                                <Run Text="начинается"/>
                                <LineBreak/>
                                <Run Text="прямо здесь!"
                                     Foreground="#60A5FA"/>
                            </TextBlock>

                            <Border Width="315"
                                    Height="4"
                                    Background="#3B82F6"
                                    CornerRadius="2"
                                    HorizontalAlignment="Left"
                                    Margin="0,17,0,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#3B82F6"
                                                      BlurRadius="12"
                                                      ShadowDepth="0"
                                                      Opacity="0.45"/>
                                </Border.Effect>
                            </Border>

                            <TextBlock Text="Твой путь к шахматному мастерству начинается с одного хода."
                                       FontSize="17"
                                       Foreground="#A8B9D2"
                                       TextWrapping="Wrap"
                                       TextAlignment="Left"
                                       HorizontalAlignment="Left"
                                       MaxWidth="510"
                                       LineHeight="25"
                                       Margin="0,0,0,17"/>

                            <TextBlock Text="ИГРАЙ. РЕШАЙ ЗАДАЧИ. РАЗВИВАЙСЯ."
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#60A5FA"
                                       Margin="0,0,0,23"/>

                            <StackPanel>
                                <Border Style="{StaticResource FeatureCardStyle}"
                                        MouseEnter="FeatureCard_MouseEnter"
                                        MouseLeave="FeatureCard_MouseLeave">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="11"
                                                Background="#1D3B66"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="♙"
                                                       FontFamily="Segoe UI Symbol"
                                                       FontSize="25"
                                                       Foreground="#60A5FA"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="13,0,0,0">
                                            <TextBlock Text="Обучающие курсы"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E2EAF7"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="Осваивай шахматную теорию шаг за шагом"
                                                       FontSize="13"
                                                       Foreground="#9AACC6"
                                                       Margin="0,5,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource FeatureCardStyle}"
                                        MouseEnter="FeatureCard_MouseEnter"
                                        MouseLeave="FeatureCard_MouseLeave">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="11"
                                                Background="#1D3B66"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="♟"
                                                       FontFamily="Segoe UI Symbol"
                                                       FontSize="25"
                                                       Foreground="#60A5FA"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="13,0,0,0">
                                            <TextBlock Text="Шахматные задачи"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E2EAF7"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="Развивай тактику и проверяй свои навыки"
                                                       FontSize="13"
                                                       Foreground="#9AACC6"
                                                       Margin="0,5,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource FeatureCardStyle}"
                                        Margin="0"
                                        MouseEnter="FeatureCard_MouseEnter"
                                        MouseLeave="FeatureCard_MouseLeave">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="11"
                                                Background="#1D3B66"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="♛"
                                                       FontFamily="Segoe UI Symbol"
                                                       FontSize="25"
                                                       Foreground="#60A5FA"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="13,0,0,0">
                                            <TextBlock Text="Твой прогресс"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E2EAF7"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="Отслеживай результаты и становись сильнее"
                                                       FontSize="13"
                                                       Foreground="#9AACC6"
                                                       Margin="0,5,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center">

                        <Grid x:Name="LoginHost"
                              MaxWidth="650"
                              HorizontalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    BorderBrush="#1E2D45"
                    BorderThickness="0,1,0,0"
                    Padding="20,10">

                <TextBlock Text="© 2026 Checkmate Academy. Все права защищены."
                           Foreground="#64748B"
                           FontSize="12"
                           HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Window>
