<UserControl x:Class="CheckmateAcademy.Presentation.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="InputFrameStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D1729"/>
            <Setter Property="BorderBrush" Value="#344665"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="0"
                                      ShadowDepth="0"
                                      Color="#2563EB"
                                      Opacity="0"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#45618C"/>
                </Trigger>

                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="17"
                                              ShadowDepth="0"
                                              Color="#2563EB"
                                              Opacity="0.22"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                CornerRadius="12"
                                Background="#2563EB"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="ButtonSurface"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#3B82F6"
                                                            Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonSurface"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.015"
                                                             Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonSurface"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.015"
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="ButtonSurface"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#2563EB"
                                                            Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonSurface"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1"
                                                             Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonSurface"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1"
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Opacity"
                                        Value="0.82"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="Transparent"
                                CornerRadius="7"
                                Padding="7,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#1A3B82F6"/>
                                <Setter Property="Foreground"
                                        Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="#111C30"
                BorderBrush="#293D5D"
                BorderThickness="1"
                CornerRadius="23"
                Padding="42">

            <Border.Effect>
                <DropShadowEffect BlurRadius="35"
                                  ShadowDepth="0"
                                  Color="#000000"
                                  Opacity="0.28"/>
            </Border.Effect>

            <StackPanel>
                <Border Background="#192F50"
                        BorderBrush="#294D7C"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="10,5"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,22">

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="#60A5FA"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>

                        <TextBlock Text="ЛИЧНЫЙ КАБИНЕТ"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#BFDBFE"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="С возвращением!"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#F8FAFC"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Войдите в аккаунт, чтобы продолжить обучение"
                           FontSize="14"
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"
                           Margin="0,10,0,32"/>

                <TextBlock Text="ЭЛЕКТРОННАЯ ПОЧТА"
                           Foreground="#C4D0E2"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <Border Style="{StaticResource InputFrameStyle}"
                        Height="60">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="✉"
                                   Foreground="#7891B5"
                                   FontSize="19"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="EmailTextBox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#F8FAFC"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="#60A5FA"
                                 SelectionBrush="#2563EB"/>
                    </Grid>
                </Border>

                <TextBlock Text="ПАРОЛЬ"
                           Foreground="#C4D0E2"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,24,0,10"/>

                <Border Style="{StaticResource InputFrameStyle}"
                        Height="60">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="◆"
                                   Foreground="#7891B5"
                                   FontSize="16"
                                   VerticalAlignment="Center"/>

                        <PasswordBox x:Name="PasswordBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#F8FAFC"
                                     FontSize="15"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="#60A5FA"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="ErrorMessageTextBlock"
                           Foreground="#F87171"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,13,0,0"
                           Visibility="Collapsed"/>

                <Button x:Name="LoginButton"
                        Content="Войти в аккаунт"
                        Click="LoginButton_Click"
                        Style="{StaticResource LoginButtonStyle}"
                        Margin="0,27,0,0"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,25,0,0">

                    <TextBlock Text="Нет аккаунта?"
                               Foreground="#94A3B8"
                               FontSize="13"
                               VerticalAlignment="Center"/>

                    <Button Content="Зарегистрироваться"
                            Click="RegisterButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
