<UserControl x:Class="CheckmateAcademy.Presentation.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource ContentCard}">
        <StackPanel>
            <TextBlock Text="Тактические задачи"
                       Style="{StaticResource PageHeading}"/>
            <TextBlock Text="Задачи, подсказки, проверка решений и статистика прогресса."
                       Style="{StaticResource DescriptionText}"
                       Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</UserControl>