<UserControl x:Class="CheckmateAcademy.Presentation.Views.StudyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource ContentCard}">
        <StackPanel>
            <TextBlock Text="Анализ партий"
                       Style="{StaticResource PageHeading}"/>
            <TextBlock Text="Свободная шахматная доска, настройка позиций и дерево вариантов."
                       Style="{StaticResource DescriptionText}"
                       Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</UserControl>