<UserControl x:Class="CheckmateAcademy.Presentation.Views.BotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource ContentCard}">
        <StackPanel>
            <TextBlock Text="Игра с ботом"
                       Style="{StaticResource PageHeading}"/>
            <TextBlock Text="Выбор соперника, уровень сложности и шахматная партия."
                       Style="{StaticResource DescriptionText}"
                       Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</UserControl>