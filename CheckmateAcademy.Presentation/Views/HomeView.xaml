<UserControl x:Class="CheckmateAcademy.Presentation.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <Border Style="{StaticResource ContentCard}"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                MaxWidth="560">

                        <TextBlock Text="Добро пожаловать!"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Учись думать как шахматист. Изучай дебюты, решай тактические задачи и анализируй собственные партии."
                                   Style="{StaticResource DescriptionText}"
                                   FontSize="15"
                                   Margin="0,14,0,22"/>

                        <Button Content="Перейти к курсам"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding DataContext.NavigateCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Courses"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="♞"
                               FontSize="100"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="25,0,10,0"/>
                </Grid>
            </Border>

            <TextBlock Text="ТВОЯ АКАДЕМИЯ"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,0,0,14"/>

            <UniformGrid Columns="2" Rows="2">

                <Border Style="{StaticResource ContentCard}"
                        Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="♟"
                                   FontSize="30"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Курсы"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,6"/>
                        <TextBlock Text="Теория, уроки и интерактивные упражнения"
                                   Style="{StaticResource DescriptionText}"
                                   Margin="0,0,0,16"/>
                        <Button Content="Открыть курсы"
                                Style="{StaticResource NavigationButton}"
                                Command="{Binding DataContext.NavigateCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Courses"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ContentCard}"
                        Margin="12,0,0,12">
                    <StackPanel>
                        <TextBlock Text="♜"
                                   FontSize="30"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Тактика"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,6"/>
                        <TextBlock Text="Задачи на комбинации и поиск лучшего хода"
                                   Style="{StaticResource DescriptionText}"
                                   Margin="0,0,0,16"/>
                        <Button Content="Решать задачи"
                                Style="{StaticResource NavigationButton}"
                                Command="{Binding DataContext.NavigateCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Tasks"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ContentCard}"
                        Margin="0,12,12,0">
                    <StackPanel>
                        <TextBlock Text="♚"
                                   FontSize="30"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Игра с ботом"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,6"/>
                        <TextBlock Text="Играй против соперников разного уровня"
                                   Style="{StaticResource DescriptionText}"
                                   Margin="0,0,0,16"/>
                        <Button Content="Начать игру"
                                Style="{StaticResource NavigationButton}"
                                Command="{Binding DataContext.NavigateCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Bot"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ContentCard}"
                        Margin="12,12,0,0">
                    <StackPanel>
                        <TextBlock Text="♗"
                                   FontSize="30"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Анализ партий"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,6"/>
                        <TextBlock Text="Создавай позиции и исследуй варианты"
                                   Style="{StaticResource DescriptionText}"
                                   Margin="0,0,0,16"/>
                        <Button Content="Открыть анализ"
                                Style="{StaticResource NavigationButton}"
                                Command="{Binding DataContext.NavigateCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Study"/>
                    </StackPanel>
                </Border>

            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
